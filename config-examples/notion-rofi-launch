#!/bin/sh
# Unified launcher on the focused output: one box that switches to an open
# window or launches an app.
#
# This uses rofi's native combi (window + drun). It requires a rofi build with
# ext-foreign-toplevel-list-v1 support in the window modi, since River does not
# serve wlr-foreign-toplevel-management. Focus is delegated to notion-ctl via
# the `window-activate-command` rofi option (set in ~/.config/rofi/config.rasi):
#
#   window-activate-command: "notion-ctl focus-window-by-identifier {identifier}";
#
# notion-river advertises every output at position 0,0 to layer-shell clients,
# so rofi cannot place itself by coordinates; we resolve the focused output
# from notion-ctl and pass it via -m.
set -eu

: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export XDG_RUNTIME_DIR

out=$(notion-ctl list-workspaces | python3 -c '
import json, sys
try:
    wss = json.load(sys.stdin)
except Exception:
    wss = []
for w in wss:
    if w.get("focused") and w.get("output"):
        print(w["output"])
        break
')

set -- rofi -show combi -modi "combi" -combi-modi "window,drun" \
    -drun-match-fields "name,generic,exec,categories,keywords,comment"

[ -n "$out" ] && set -- "$@" -m "$out"

exec "$@"
