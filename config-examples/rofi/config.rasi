/*
 * Example rofi config for notion-river.
 *
 * Copy this directory to ~/.config/rofi/ :
 *   mkdir -p ~/.config/rofi
 *   cp /usr/share/notion-river/examples/rofi/* ~/.config/rofi/
 *
 * Adjust "font" and "icon-theme" below to taste; "JetBrains Mono" + "Papirus"
 * look great if installed, otherwise any installed monospace font / icon theme
 * works (e.g. "DejaVu Sans Mono" and "Adwaita").
 */
configuration {
    font: "DejaVu Sans Mono 13";
    show-icons: true;
    icon-theme: "Adwaita";
    drun-display-format: "{name}";
    disable-history: false;
    /* Used by notion-rofi-launch (combi window+drun): River's
     * ext-foreign-toplevel-list protocol is list-only, so window focus is
     * delegated to notion-ctl. Requires a rofi build supporting this option;
     * stock rofi-wayland ignores it. */
    window-activate-command: "notion-ctl focus-window-by-identifier {identifier}";
}

@theme "catppuccin-mocha"
