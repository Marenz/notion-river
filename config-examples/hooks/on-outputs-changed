#!/bin/sh
# notion-river outputs-changed hook
#
# Reads the current output layout (JSON on stdin) and writes a kanshi
# profile to ~/.config/kanshi/config, then signals kanshi to reload.
#
# JSON format on stdin:
# {
#   "outputs": [
#     {
#       "name": "HDMI-A-1",
#       "x": 1280, "y": 832,
#       "width": 2560, "height": 1440,
#       "physical_width": 3840, "physical_height": 2160,
#       "scale": 1.5, "wl_scale": 2,
#       "transform": 0
#     }, ...
#   ]
# }

set -eu

KANSHI_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/kanshi/config"

# Read JSON from stdin
json=$(cat)

# Map Wayland transform integers to kanshi transform names
transform_name() {
    case "$1" in
        0) echo "normal" ;;
        1) echo "90" ;;
        2) echo "180" ;;
        3) echo "270" ;;
        4) echo "flipped" ;;
        5) echo "flipped-90" ;;
        6) echo "flipped-180" ;;
        7) echo "flipped-270" ;;
        *) echo "normal" ;;
    esac
}

# Count outputs
count=$(echo "$json" | jq '.outputs | length')

if [ "$count" -eq 0 ]; then
    exit 0
fi

# Build a profile name from the sorted output names
profile_name=$(echo "$json" | jq -r '[.outputs[].name] | sort | join("+")')

# Generate kanshi config
mkdir -p "$(dirname "$KANSHI_CONFIG")"

{
    echo "profile $profile_name {"
    echo "$json" | jq -r '.outputs[] | @base64' | while read -r entry; do
        _jq() {
            echo "$entry" | base64 -d | jq -r "$1"
        }
        name=$(_jq '.name')
        phys_w=$(_jq '.physical_width')
        phys_h=$(_jq '.physical_height')
        x=$(_jq '.x')
        y=$(_jq '.y')
        scale=$(_jq '.scale')
        transform=$(_jq '.transform')

        t_name=$(transform_name "$transform")
        echo "    output $name mode ${phys_w}x${phys_h} position ${x},${y} transform $t_name scale $scale"
    done
    echo "}"
} > "$KANSHI_CONFIG"

# Reload kanshi (SIGHUP triggers config reload)
pkill -HUP kanshi 2>/dev/null || true
