#!/bin/sh
# Open the switch-or-launch menu on the currently focused output.
#
# Kept as a separate command because `commands.window_switcher` (Super+Shift+o)
# is bound to it, but the menu is the same unified list as the launcher: since
# notion-rofi-window-mode already lists open windows alongside launchable apps,
# a windows-only switcher would be a strict subset with no extra value.
#
# See notion-rofi-launch for why the built-in rofi `window` modi is not used.
set -eu

exec notion-rofi-launch "$@"
